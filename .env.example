# Provider: set ONE of the two keys below (or both; Anthropic wins unless LAMBDA_PROVIDER is set)
# LAMBDA_PROVIDER=anthropic | openai   (optional override)

# Anthropic
ANTHROPIC_API_KEY=
# Optional model override (default: claude-sonnet-5)
ANTHROPIC_MODEL=

# OpenAI-compatible (honors OPENAI_BASE_URL for Ollama/local servers)
OPENAI_API_KEY=
# Optional model override (default: gpt-5.6-terra)
OPENAI_MODEL=
OPENAI_BASE_URL=
